# Sao chép thành .env rồi điền giá trị thật. File .env đã nằm trong .gitignore.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model dùng khi chạy thử (rẻ) và khi chạy chính thức.
# Tên model dưới đây là PLACEHOLDER — kiểm tra lại tên chính xác trong tài liệu API DeepSeek (task 1.2).
# Spike 29/09 xác nhận dsh dùng deepseek-flash; tên model chính thức chờ GVHD duyệt.
DEEPSEEK_MODEL_DEV=deepseek-v4-flash
DEEPSEEK_MODEL_MAIN=deepseek-v4-pro
