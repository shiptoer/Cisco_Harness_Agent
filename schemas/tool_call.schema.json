      "properties": {
        "tool": {
          "const": "add_acl_entry"
        },
        "args": {
          "additionalProperties": false,
          "properties": {
            "device": {
              "pattern": "^[A-Za-z0-9-]{1,32}$",
              "title": "Device",
              "type": "string"
            },
            "acl_name": {
              "pattern": "^[A-Za-z0-9_-]{1,32}$",
              "title": "Acl Name",
              "type": "string"
            },
            "seq": {
              "maximum": 2147483647,
              "minimum": 1,
              "title": "Seq",
              "type": "integer"
            },
            "action": {
              "enum": [
                "permit",
                "deny"
              ],
              "title": "Action",
              "type": "string"
