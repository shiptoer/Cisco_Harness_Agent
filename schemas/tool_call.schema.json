            "protocol": {
              "enum": [
                "tcp",
                "udp",
                "ip",
                "icmp"
              ],
              "title": "Protocol",
              "type": "string"
            },
            "src": {
              "pattern": "^(any|host \\d{1,3}(\\.\\d{1,3}){3}|\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2})$",
              "title": "Src",
              "type": "string"
            },
            "dst": {
              "pattern": "^(any|host \\d{1,3}(\\.\\d{1,3}){3}|\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2})$",
              "title": "Dst",
              "type": "string"
            },
            "dst_port": {
              "anyOf": [
                {
                  "pattern": "^(eq|gt|lt|neq) \\d{1,5}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Dst Port"
            }
          },
          "required": [
            "device",
            "acl_name",
            "seq",
            "action",
            "protocol",
            "src",
            "dst"
          ],
          "title": "AddAclEntryArgs",
          "type": "object"
        }
      },
      "required": [
        "tool",
        "args"
      ],
      "additionalProperties": false
